{
  "compilerOptions": {
    "target": "esnext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["esnext", "dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/common",
    "src/main",
    "src/preload",
    "src/*.d.ts",
    "package.json",
    "eslint.config.ts",
    "vite.config.mts",
    "buildAssets/builder",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "tests/**/*.spec.ts"
  ]
}
