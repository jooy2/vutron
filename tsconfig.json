{
  "compilerOptions": {
    "types": ["node"],
    "outDir": "./dist",
    "target": "esnext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "rootDir": "./src"
  },
  "include": ["src/*.ts", "src/*.d.ts", "src/common", "src/renderer"]
}
